generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Check constraints are defined in db/schema.sql because Prisma schema syntax cannot represent them.
model User {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @map("user_id") @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(120)
  email        String   @unique(map: "uq_users_email") @db.VarChar(191)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  devices      Device[]

  @@map("users")
}

model Device {
  id               String        @id @default(dbgenerated("uuid_generate_v4()")) @map("device_id") @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  deviceName       String        @map("device_name") @db.VarChar(100)
  platform         String        @db.VarChar(20)
  isActive         Boolean       @default(true) @map("is_active")
  lastSeenAt       DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  activities       ActivityLog[]
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  uploadedFiles    FileRecord[]  @relation("SourceFiles")
  receivedFiles    FileRecord[]  @relation("TargetFiles")
  notes            Note[]
  consumedPairings PairingCode[] @relation("ConsumedPairings")
  createdPairings  PairingCode[] @relation("CreatedPairings")
  tasks            Task[]

  @@index([userId, isActive], map: "idx_devices_user_active")
  @@map("devices")
}

model PairingCode {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @map("pairing_id") @db.Uuid
  createdByDeviceId  String    @map("created_by_device_id") @db.Uuid
  consumedByDeviceId String?   @map("consumed_by_device_id") @db.Uuid
  codeHash           String    @unique @map("code_hash") @db.VarChar(64)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt             DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  consumedByDevice   Device?   @relation("ConsumedPairings", fields: [consumedByDeviceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdByDevice    Device    @relation("CreatedPairings", fields: [createdByDeviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_pairing_codes_expiry")
  @@map("pairing_codes")
}

model Note {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @map("note_id") @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  title     String   @db.VarChar(200)
  body      String
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([deviceId, updatedAt(sort: Desc)], map: "idx_notes_device_updated")
  @@map("notes")
}

model Task {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @map("task_id") @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  title       String    @db.VarChar(200)
  description String    @default("")
  priority    String    @default("medium") @db.VarChar(10)
  status      String    @default("todo") @db.VarChar(20)
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  device      Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([deviceId, status, dueAt], map: "idx_tasks_device_status_due")
  @@map("tasks")
}

model FileRecord {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @map("file_id") @db.Uuid
  sourceDeviceId String   @map("source_device_id") @db.Uuid
  targetDeviceId String?  @map("target_device_id") @db.Uuid
  originalName   String   @map("original_name") @db.VarChar(255)
  storageKey     String   @unique @map("storage_key") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  sizeBytes      BigInt   @map("size_bytes")
  checksumSha256 String   @map("checksum_sha256") @db.VarChar(64)
  direction      String   @default("to_desktop") @db.VarChar(20)
  status         String   @default("stored") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceDevice   Device   @relation("SourceFiles", fields: [sourceDeviceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  targetDevice   Device?  @relation("TargetFiles", fields: [targetDeviceId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([sourceDeviceId, createdAt(sort: Desc)], map: "idx_files_source_created")
  @@map("files")
}

model ActivityLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @map("activity_id") @db.Uuid
  deviceId   String   @map("device_id") @db.Uuid
  actionType String   @map("action_type") @db.VarChar(50)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   String   @map("target_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deviceId, createdAt(sort: Desc)], map: "idx_activity_device_created")
  @@map("activity_logs")
}
